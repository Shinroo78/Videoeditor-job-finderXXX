    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst THREE_DAYS_IN_MS = 3 * 24 * 60 * 60 * 1000;\n\nreturn $input.all().filter(item => {\n  const data = item.json;\n  \n  const title = (data.title || \"\").trim();\n  const description = (data.description || \"\").trim();\n  const text = (data.text || \"\").trim();\n  \n  const fullText = (title + \" \" + description + \" \" + text).toLowerCase();\n\n  // 1. شرط الحد الأدنى للطول: إذا كان النص عبارة عن هاشتاغ قصير أو رابط فقط (أقل من 15 حرف)، احذفه فوراً\n  if (fullText.length < 15) {\n    return false;\n  }\n\n  // 2. التحقق من التاريخ (إذا لم يتوفر، نمرره افتراضياً)\n  const rawDate = data.createdAt || data.publishedAt || data.date;\n  let isRecent = true;\n  if (rawDate) {\n    const postDate = new Date(rawDate);\n    const timeDifference = now - postDate;\n    isRecent = timeDifference >= 0 && timeDifference <= THREE_DAYS_IN_MS;\n  }\n\n  // 3. استبعاد تام لأي شخص يعرض خدماته أو يضع هاشتاغات تسويقية\n  const isServiceProvider = \n    fullText.includes(\"#editorforhire\") || \n    fullText.includes(\"i am a video editor\") || \n    fullText.includes(\"i'm a video editor\") || \n    fullText.includes(\"hire me\") ||\n    fullText.includes(\"my services\") ||\n    title.toLowerCase().startsWith(\"need a video editor?\");\n\n  // 4. شرط القبول: يجب أن يحتوي النص على كلمات تعبر عن طلب حقيقي أو بحث عن خدمة\n  const hasClientIntent = \n    fullText.includes(\"looking for\") || \n    fullText.includes(\"hiring\") || \n    fullText.includes(\"need an editor\") || \n    fullText.includes(\"مطلوب\") || \n    fullText.includes(\"أبحث عن\");\n\n  // الشرط النهائي الصارم: حديث + ليس مقدم خدمات + يحتوي على نية طلب حقيقية + النص ليس مجرد هاشتاغ قصير\n  return isRecent && !isServiceProvider && hasClientIntent;\n});"
      },
